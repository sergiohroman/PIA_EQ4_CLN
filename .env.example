# Copie este archivo a .env y ajuste. NUNCA suba .env con secretos reales (12-Factor).

# --- Base de datos (Docker Compose) ---
POSTGRES_USER=vetcare
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=vetcare24

# --- Aplicación ---
APP_PORT=8000
# Si se omite, la app usa SQLite local (sqlite:///./vetcare.db).
# En Docker Compose se arma a partir de las variables POSTGRES_*.
# En Render/Railway la plataforma inyecta DATABASE_URL automáticamente.
DATABASE_URL=

# --- Pruebas contra PostgreSQL (opcional; por defecto usan SQLite en memoria) ---
TEST_DATABASE_URL=
